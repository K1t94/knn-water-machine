# Runtime mode for local development only.
NODE_ENV=development
# HTTP port exposed by the NestJS API.
API_PORT=3000

# Local-only PostgreSQL defaults. Do not use these values outside development.
POSTGRES_DB=kaynann
POSTGRES_USER=kaynann
POSTGRES_PASSWORD=local_dev_only_not_for_production
# Local connection string consumed by Prisma; never replace with production data here.
DATABASE_URL=postgresql://kaynann:local_dev_only_not_for_production@localhost:5432/kaynann?schema=public
# Local Redis endpoint.
REDIS_URL=redis://localhost:6379
# Local Mosquitto endpoint used for connectivity checks only.
MQTT_URL=mqtt://localhost:1883
# Non-secret local MQTT client identifier.
MQTT_CLIENT_ID=kaynann-api-local
SMS_PROVIDER=fake
