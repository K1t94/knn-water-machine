# Runtime mode for local development only.
NODE_ENV=development
# HTTP port exposed by the NestJS API.
API_PORT=3000
# Base URL used by the operational referral toggle package scripts.
REFERRAL_OPERATIONS_URL=http://localhost:3000
# Public mobile fallback used when device location is unavailable.
EXPO_PUBLIC_MACHINE_SERVICE_AREA_CODE=dakar

# Local-only PostgreSQL defaults. Do not use these values outside development.
POSTGRES_DB=kaynann
POSTGRES_USER=kaynann
POSTGRES_PASSWORD=local_dev_only_not_for_production
# Local connection string consumed by Prisma; never replace with production data here.
DATABASE_URL=postgresql://kaynann:local_dev_only_not_for_production@localhost:5432/kaynann?schema=public
# Local Redis endpoint.
REDIS_URL=redis://localhost:6379
# Local Mosquitto endpoint used for connectivity checks only.
MQTT_URL=mqtt://localhost:1883
# Non-secret local MQTT client identifier.
MQTT_CLIENT_ID=kaynann-api-local
SMS_PROVIDER=fake

# Machine discovery is disabled unless a local developer explicitly enables the emulator.
MACHINE_GATEWAY_MODE=disabled
MACHINE_FIXTURE_MODE=false
MACHINE_LEGACY_QR_ENABLED=false
MACHINE_CURSOR_TTL_SECONDS=300
MACHINE_AVAILABILITY_FRESHNESS_SECONDS=60
MACHINE_AVAILABILITY_ALLOWED_CLOCK_SKEW_SECONDS=5
MACHINE_SERVICE_AREA_NORTH=56.10
MACHINE_SERVICE_AREA_EAST=38.20
MACHINE_SERVICE_AREA_SOUTH=55.40
MACHINE_SERVICE_AREA_WEST=36.70
# Secret injection point: supply at least 32 random base64url-encoded bytes.
# MACHINE_CURSOR_HMAC_KEY=
