{
    "name": "@kaynann/water-vending",
    "private": true,
    "packageManager": "pnpm@11.18.0",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "pnpm --parallel --filter @kaynann/api --filter @kaynann/mobile run dev",
        "dev:api": "pnpm --filter @kaynann/api dev",
        "dev:mobile": "pnpm --filter @kaynann/mobile dev",
        "dev:mobile:clear": "pnpm --filter @kaynann/mobile dev:clear",
        "dev:mobile:web": "pnpm --filter @kaynann/mobile dev:web",
        "lint": "eslint --max-warnings=0 .",
        "lint:mobile": "pnpm --filter @kaynann/mobile lint",
        "lint:api": "pnpm --filter @kaynann/api lint",
        "lint:fix": "eslint --max-warnings=0 . --fix",
        "lint:rules:test": "node scripts/verify-eslint-rules.mjs",
        "format:check": "prettier --check .",
        "format:write": "exec prettier --write .",
        "typecheck": "tsc --noEmit",
        "test": "pnpm --recursive --if-present test",
        "build:api": "pnpm --filter @kaynann/api build",
        "build:mobile:js": "pnpm --filter @kaynann/mobile build:js",
        "services:up": "docker compose -f infra/compose.yaml up -d",
        "services:down": "docker compose -f infra/compose.yaml down",
        "db:migrate": "node scripts/db-migrate.mjs",
        "db:generate": "pnpm --filter @kaynann/api db:generate",
        "verify:start": "node scripts/verify-startup.mjs",
        "verify:phone-auth-performance": "pnpm build:api && node scripts/verify-phone-auth-performance.mjs",
        "mobile:doctor": "node scripts/mobile-doctor.mjs",
        "mobile:prebuild": "pnpm --filter @kaynann/mobile prebuild",
        "check:env": "node scripts/check-env-example.mjs",
        "check:repo": "node scripts/check-repo-bootstrap.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@types/node": "^22.15.21",
        "@vitest/eslint-plugin": "1.6.25",
        "eslint": "^9.28.0",
        "eslint-config-expo": "10.0.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-react-native": "5.0.0",
        "eslint-plugin-rxjs-x": "0.9.6",
        "eslint-plugin-testing-library": "7.16.2",
        "eslint-plugin-unused-imports": "4.4.1",
        "prettier": "^3.5.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.34.0",
        "vitest": "^3.2.4"
    }
}
