{
    "name": "@kaynann/mobile",
    "version": "0.1.0",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "dev": "expo start --dev-client",
        "dev:clear": "expo start --dev-client --clear",
        "dev:web": "APP_ENV=development EXPO_DEV_WEB=true expo start --web",
        "start": "expo start",
        "lint": "eslint --max-warnings=0 src __tests__ index.ts app.config.ts vitest.config.ts vitest.setup.ts",
        "lint:fix": "eslint --max-warnings=0 src __tests__ index.ts app.config.ts vitest.config.ts vitest.setup.ts --fix",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "build:js": "EXPO_NO_TELEMETRY=1 expo export --platform all --output-dir dist/mobile",
        "prebuild": "EXPO_NO_TELEMETRY=1 expo prebuild",
        "android": "expo run:android",
        "ios": "expo run:ios"
    },
    "dependencies": {
        "@react-navigation/native": "^7.3.14",
        "@react-navigation/native-stack": "^7.18.6",
        "expo": "^54.0.0",
        "expo-clipboard": "~8.0.8",
        "expo-dev-client": "^6.0.0",
        "expo-secure-store": "~15.0.8",
        "mobx": "^6.16.1",
        "mobx-react-lite": "^4.1.1",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "0.81.5",
        "react-native-safe-area-context": "~5.6.2",
        "react-native-screens": "~4.16.0",
        "react-native-web": "^0.21.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@testing-library/react-native": "^14.0.1",
        "@types/react": "~19.1.10",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    }
}
