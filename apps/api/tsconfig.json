{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "noEmit": true,
        "outDir": "./dist",
        "strict": true,
        "target": "ES2022",
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
