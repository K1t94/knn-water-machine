{
    "name": "@kaynann/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main.js",
        "lint": "eslint --max-warnings=0 src test vitest.config.ts",
        "lint:fix": "eslint --max-warnings=0 src test vitest.config.ts --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "openapi:generate": "ts-node --transpile-only src/openapi/generate-openapi.ts --write",
        "openapi:check": "ts-node --transpile-only src/openapi/generate-openapi.ts --check",
        "referral:provision": "ts-node --transpile-only src/referral/cli/provision-referrals.ts",
        "referral:recover": "ts-node --transpile-only src/referral/cli/recover-referral-bonuses.ts",
        "test:referral:postgres": "RUN_POSTGRES_INTEGRATION=1 vitest run test/referral-*.integration-spec.ts",
        "test:referral:registration": "RUN_POSTGRES_INTEGRATION=1 RUN_REDIS_INTEGRATION=1 vitest run test/referral-registration.integration-spec.ts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate deploy",
        "db:migrate:dev": "prisma migrate dev"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.6",
        "@nestjs/core": "^11.1.6",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/platform-express": "^11.1.6",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.6",
        "@nestjs/testing": "^11.1.6",
        "@prisma/client": "^6.16.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dotenv": "^16.5.0",
        "libphonenumber-js": "^1.13.9",
        "mqtt": "^5.13.0",
        "prom-client": "^15.1.3",
        "redis": "^5.8.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^3.25.67"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.10",
        "@types/express": "^5.0.3",
        "@types/node": "^22.15.21",
        "@types/supertest": "^6.0.3",
        "prisma": "^6.16.2",
        "supertest": "^7.1.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    }
}
