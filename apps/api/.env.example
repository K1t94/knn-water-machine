CREDENTIAL_HMAC_KEY=<base64url-of-at-least-32-random-bytes>
FINGERPRINT_HMAC_KEY_VERSION=v1
FINGERPRINT_HMAC_KEY=<base64url-of-at-least-32-random-bytes>
REGISTRATION_RESULT_KEY_VERSION=v1
REGISTRATION_RESULT_ENCRYPTION_KEY=<base64url-of-exactly-32-random-bytes>
REGISTRATION_AUTH_TTL_SECONDS=900
JWT_ACCESS_KEY_VERSION=v1
JWT_ACCESS_SIGNING_KEY=<base64url-of-at-least-32-random-bytes>
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=60

OTP_SENDS_PER_PHONE_HOUR=3
OTP_SENDS_PER_PHONE_DAY=6
OTP_SENDS_PER_IP_HOUR=20
OTP_SENDS_PER_INSTALLATION_HOUR=10
OTP_SENDS_PER_INSTALLATION_DAY=20
OTP_EXHAUSTED_CHALLENGES_PER_DAY=3
OTP_PHONE_BLOCK_SECONDS=1800
OTP_MAX_PARALLEL_SENDS_GLOBAL=5
SMS_MAX_SENDS_PER_SECOND=5
SMS_DAILY_COUNT_LIMIT=500
SMS_ESTIMATED_UNIT_COST_XOF=20
SMS_DAILY_XOF_LIMIT=10000
SMS_DAILY_COUNT_WARNING_PERCENT=80
SMS_DAILY_COUNT_CRITICAL_PERCENT=95
SMS_DAILY_XOF_WARNING_PERCENT=80
SMS_DAILY_XOF_CRITICAL_PERCENT=95

SMS_PROVIDER=fake
FAKE_SMS_EXPOSE_OTP=false
FAKE_SMS_TEST_NUMBERS=+221771234567
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=
ORANGE_SMS_SENDER_NAME=KAYNANN
