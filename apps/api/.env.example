NODE_ENV=development
APP_ENV=development
API_PORT=3000
TRUSTED_PROXY_IPS=
DATABASE_URL=postgresql://user:password@localhost:5432/kaynann?schema=public
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=kaynann-api-local

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HMAC_KEY_VERSION=v1
