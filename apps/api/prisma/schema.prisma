generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum LegalDocumentKind {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
}

enum UserSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SessionRevokeReason {
  LOGOUT
  REPLAY
  ADMIN
  EXPIRED
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum SmsProviderKind {
  FAKE
  ORANGE
}

enum SmsDeliveryStatus {
  PREPARED
  ACCEPTED
  DELIVERED
  UNCERTAIN
  FAILED
}

enum SmsFailureCategory {
  INVALID_CONFIGURATION
  AUTHENTICATION_FAILED
  BALANCE_EXHAUSTED
  PROVIDER_RATE_LIMITED
  INVALID_RECIPIENT
  MESSAGE_REJECTED
  TIMEOUT
  TEMPORARY_PROVIDER_FAILURE
}

enum WalletDirection {
  CREDIT
  DEBIT
}

enum ReferralFeatureKey {
  REFERRAL_PROGRAM
}

enum ReferralApplicationChannel {
  REGISTRATION
  POST_REGISTRATION
}

enum ReferralBonusKind {
  WELCOME
  INVITER
}

enum ReferralBonusDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  PERMANENT_FAILURE
}

enum MachinePublicationState {
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum MachineServiceMode {
  NORMAL
  SERVICE
}

enum MachineEvidenceState {
  READY
  OFFLINE
  UNKNOWN
}

enum MachineIdentifierKind {
  CURRENT_MANUAL
  LEGACY_MANUAL
  LEGACY_QR
}

model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  phoneE164                 String                     @unique @db.VarChar(16)
  phoneConfirmedAt          DateTime                   @db.Timestamptz(3)
  status                    UserStatus                 @default(ACTIVE)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  legalAcceptances          LegalAcceptance[]
  sessions                  UserSession[]
  waterWallet               WaterWallet?
  referralPromoCode         ReferralPromoCode?
  invitedReferrals          ReferralRelationship[]     @relation("ReferralInviter")
  receivedReferral          ReferralRelationship?      @relation("ReferralInvitee")
  referralBonusEntitlements ReferralBonusEntitlement[]

  @@index([status, id])
}

model LegalDocument {
  id               String            @id @default(uuid()) @db.Uuid
  kind             LegalDocumentKind
  version          String            @db.VarChar(64)
  locale           String            @db.VarChar(16)
  title            String            @db.VarChar(200)
  content          String
  contentSha256    String            @db.Char(64)
  mandatory        Boolean
  isCurrent        Boolean
  publishedAt      DateTime          @db.Timestamptz(3)
  effectiveAt      DateTime          @db.Timestamptz(3)
  retiredAt        DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  legalAcceptances LegalAcceptance[]

  @@unique([kind, version, locale])
  @@index([mandatory, isCurrent, locale])
}

model LegalAcceptance {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @db.Uuid
  legalDocumentId         String        @db.Uuid
  acceptedAt              DateTime      @default(now()) @db.Timestamptz(3)
  registrationFlowId      String        @db.Uuid
  ipFingerprint           String?       @db.Char(64)
  installationFingerprint String?       @db.Char(64)
  userAgentFamily         String?       @db.VarChar(100)
  user                    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocument           LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentId])
  @@index([userId, acceptedAt(sort: Desc)])
}

model UserSession {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @db.Uuid
  familyId                String                @unique @db.Uuid
  installationFingerprint String                @db.Char(64)
  creationKeyDigest       String                @unique @db.Char(64)
  status                  UserSessionStatus     @default(ACTIVE)
  expiresAt               DateTime              @db.Timestamptz(3)
  lastUsedAt              DateTime?             @db.Timestamptz(3)
  revokedAt               DateTime?             @db.Timestamptz(3)
  revokeReason            SessionRevokeReason?
  replayDetectedAt        DateTime?             @db.Timestamptz(3)
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(3)
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens           SessionRefreshToken[]

  @@index([userId, status])
  @@index([expiresAt, status])
}

model SessionRefreshToken {
  id           String               @id @default(uuid()) @db.Uuid
  sessionId    String               @db.Uuid
  tokenDigest  String               @unique @db.Char(64)
  generation   Int
  status       RefreshTokenStatus   @default(ACTIVE)
  issuedAt     DateTime             @default(now()) @db.Timestamptz(3)
  usedAt       DateTime?            @db.Timestamptz(3)
  expiresAt    DateTime             @db.Timestamptz(3)
  replacedById String?              @unique @db.Uuid
  session      UserSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   SessionRefreshToken? @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     SessionRefreshToken? @relation("RefreshTokenReplacement")

  @@unique([sessionId, generation])
  @@index([expiresAt, status])
}

model SmsDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  challengeId       String              @unique @db.Uuid
  provider          SmsProviderKind
  providerMessageId String?             @db.VarChar(255)
  phoneFingerprint  String              @db.Char(64)
  status            SmsDeliveryStatus   @default(PREPARED)
  failureCategory   SmsFailureCategory?
  requestedAt       DateTime            @db.Timestamptz(3)
  acceptedAt        DateTime?           @db.Timestamptz(3)
  lastReceiptAt     DateTime?           @db.Timestamptz(3)
  deliveredAt       DateTime?           @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerMessageId])
  @@index([status, updatedAt])
}

model WaterWallet {
  userId    String              @id @db.Uuid
  balanceMl BigInt              @default(0)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries   WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id                  String                    @id @default(uuid()) @db.Uuid
  sequence            BigInt                    @unique @default(autoincrement())
  walletUserId        String                    @db.Uuid
  businessEventKey    String                    @unique @db.VarChar(200)
  direction           WalletDirection
  amountMl            BigInt
  operationKind       String                    @db.VarChar(64)
  source              String                    @db.VarChar(64)
  balanceAfterMl      BigInt
  occurredAt          DateTime                  @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  compensatesEntryId  String?                   @db.Uuid
  wallet              WaterWallet               @relation(fields: [walletUserId], references: [userId], onDelete: Restrict)
  compensates         WalletLedgerEntry?        @relation("WalletLedgerCompensation", fields: [compensatesEntryId], references: [id], onDelete: Restrict)
  compensations       WalletLedgerEntry[]       @relation("WalletLedgerCompensation")
  referralEntitlement ReferralBonusEntitlement?

  @@index([walletUserId, sequence(sort: Desc)])
  @@index([compensatesEntryId])
}

model ReferralFeatureState {
  key       ReferralFeatureKey @id
  enabled   Boolean            @default(true)
  revision  BigInt             @default(1)
  updatedAt DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
}

model ReferralPromoCode {
  userId    String   @id @db.Uuid
  code      String   @unique @db.VarChar(12)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model ReferralRelationship {
  id                 String                     @id @default(uuid()) @db.Uuid
  sequence           BigInt                     @unique @default(autoincrement())
  inviterUserId      String                     @db.Uuid
  inviteeUserId      String                     @unique @db.Uuid
  channel            ReferralApplicationChannel
  appliedAt          DateTime                   @default(now()) @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  inviter            User                       @relation("ReferralInviter", fields: [inviterUserId], references: [id], onDelete: Restrict)
  invitee            User                       @relation("ReferralInvitee", fields: [inviteeUserId], references: [id], onDelete: Restrict)
  inviterEntitlement ReferralBonusEntitlement?

  @@index([inviterUserId, sequence(sort: Desc)])
}

model ReferralBonusEntitlement {
  id                     String                      @id @default(uuid()) @db.Uuid
  kind                   ReferralBonusKind
  beneficiaryUserId      String                      @db.Uuid
  relationshipId         String?                     @unique @db.Uuid
  amountMl               BigInt
  walletBusinessEventKey String                      @unique @db.VarChar(200)
  walletOperationKind    String                      @db.VarChar(64)
  walletSource           String                      @db.VarChar(64)
  occurredAt             DateTime                    @db.Timestamptz(3)
  status                 ReferralBonusDeliveryStatus @default(PENDING)
  walletLedgerEntryId    String?                     @unique @db.Uuid
  attemptCount           Int                         @default(0)
  nextAttemptAt          DateTime                    @db.Timestamptz(3)
  leaseOwner             String?                     @db.Uuid
  leaseExpiresAt         DateTime?                   @db.Timestamptz(3)
  lastErrorCode          String?                     @db.VarChar(64)
  deliveredAt            DateTime?                   @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(3)
  beneficiary            User                        @relation(fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
  relationship           ReferralRelationship?       @relation(fields: [relationshipId], references: [id], onDelete: Restrict)
  walletLedgerEntry      WalletLedgerEntry?          @relation(fields: [walletLedgerEntryId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([beneficiaryUserId, createdAt(sort: Desc)])
}

model Machine {
  id                   String                       @id @default(uuid()) @db.Uuid
  machineId            String                       @unique @db.VarChar(22)
  displayName          String?                      @db.VarChar(120)
  publicationState     MachinePublicationState      @default(HIDDEN)
  serviceMode          MachineServiceMode           @default(SERVICE)
  selectionRevision    BigInt                       @default(1)
  deletedAt            DateTime?                    @db.Timestamptz(3)
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  location             MachineLocation?
  price                MachinePrice?
  identifierMappings   MachineIdentifierMapping[]
  availabilityEvidence MachineAvailabilityEvidence?

  @@index([publicationState, deletedAt, machineId])
}

model MachineLocation {
  id                String   @id @default(uuid()) @db.Uuid
  machineInternalId String   @unique @db.Uuid
  address           String   @db.VarChar(300)
  serviceAreaCode   String   @db.VarChar(64)
  latitude          Decimal? @db.Decimal(9, 6)
  longitude         Decimal? @db.Decimal(9, 6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  machine           Machine  @relation(fields: [machineInternalId], references: [id], onDelete: Restrict)

  @@index([serviceAreaCode])
  @@index([latitude, longitude])
}

model MachinePrice {
  id                String   @id @default(uuid()) @db.Uuid
  machineInternalId String   @unique @db.Uuid
  amountPerLiter    Decimal  @db.Decimal(20, 6)
  currency          String   @db.Char(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  machine           Machine  @relation(fields: [machineInternalId], references: [id], onDelete: Restrict)
}

model MachineIdentifierMapping {
  id                String                @id @default(uuid()) @db.Uuid
  machineInternalId String                @db.Uuid
  kind              MachineIdentifierKind
  normalizedValue   String                @db.VarChar(256)
  enabled           Boolean               @default(true)
  verifiedAt        DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  machine           Machine               @relation(fields: [machineInternalId], references: [id], onDelete: Restrict)

  @@unique([kind, normalizedValue])
  @@index([kind, normalizedValue, enabled])
}

model MachineAvailabilityEvidence {
  machineInternalId String               @id @db.Uuid
  state             MachineEvidenceState
  reachable         Boolean
  readyToSell       Boolean
  salesAllowed      Boolean
  observedAt        DateTime             @db.Timestamptz(3)
  receivedAt        DateTime             @db.Timestamptz(3)
  sourceRevision    String?              @db.VarChar(100)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  machine           Machine              @relation(fields: [machineInternalId], references: [id], onDelete: Restrict)

  @@index([observedAt])
}

model MachineCatalogState {
  singletonKey     Int      @id @default(1) @db.SmallInt
  orderingRevision BigInt   @default(1)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}
