t(fetcher).toHaveBeenCalledWith(\n+            `${FIXTURE_ORIGIN}/__e2e/machine-discovery/bootstrap`,\n+            expect.objectContaining({\n+                headers: expect.objectContaining({ 'x-kaynann-e2e-control': CONTROL_CREDENTIAL.value }),\n+                method: 'POST',\n+                redirect: 'error',\n+            }),\n+        );\n+        const request = fetcher.mock.calls[0]?.[1];\n+        expect(request?.body).not.toContain(CONTROL_CREDENTIAL.value);\n+        expect(JSON.parse(request?.body as string)).toEqual({\n+            acceptanceTime: MACHINE_DISCOVERY_E2E_ACCEPTANCE_TIME,\n+            fixtureAccountId: FIXTURE_ACCOUNT_ID,\n+            scenario: { name: 'E2E_MACHINE_IDENTIFICATION_SCENARIO', value: 'manual' },\n+        });\n+    });\n+\n+    it('accepts only one allowlisted Maestro launch scenario', () => {\n+        expect(resolveMachineDiscoveryE2EScenario({ E2E_MACHINE_SELECTION_SCENARIO: 'detail-price-refresh' })).toEqual({\n+            name: 'E2E_MACHINE_SELECTION_SCENARIO',\n+            value: 'detail-price-refresh',\n+        });\n+        expect(() => resolveMachineDiscoveryE2EScenario({ E2E_MACHINE_SELECTION_SCENARIO: 'unknown' })).toThrow(\n+            'scenario argument',\n+        );\n+        expect(() =>\n+            resolveMachineDiscoveryE2EScenario({\n+                E2E_MACHINE_IDENTIFICATION_SCENARIO: 'manual',\n+                E2E_MACHINE_SELECTION_SCENARIO: 'detail-price-refresh',\n+            }),\n+        ).toThrow('only one');\n+    });\n+\n+    it('keeps the bootstrap and launch-argument native module out of the production entrypoint', () => {\n+        const mobileRoot = resolve(__dirname, '../../..');\n+        const productionEntry = readFileSync(resolve(mobileRoot, 'index.ts'), 'utf8');\n+        const e2eEntry = readFileSync(resolve(mobileRoot, 'index.e2e.ts'), 'utf8');\n+        const nativeConfig = readFileSync(resolve(mobileRoot, 'react-native.config.js'), 'utf8');\n+        const eas = JSON.parse(readFileSync(resolve(mobileRoot, 'eas.json'), 'utf8')) as {\n+            build: Record<string, { env?: Record<string, string> }>;\n+        };\n+\n+        expect(productionEntry).not.toMatch(/MachineDiscoveryE2E|react-native-launch-arguments/);\n+        expect(e2eEntry).toContain('MachineDiscoveryE2EApp');\n+        expect(eas.build['machine-discovery-e2e']?.env?.ENTRY_FILE).toBe('index.e2e.ts');\n+        expect(eas.build.production?.env).toBeUndefined();\n+        expect(nativeConfig).toContain(\"process.env.APP_ENV === 'e2e'\");\n+        expect(nativeConfig).toContain('android: null');\n+        expect(nativeConfig).toContain('ios: null');\n+    });\n });\n*** Update File: /Users/k1t94/Work/Projects/kaynann/knn-water-machine/apps/api/test/machines/support/machine-discovery-e2e-control.spec.ts\n@@\n+import { readFileSync } from 'node:fs';\n+import { resolve } from 'node:path';\n+\n import { describe, expect, it, vi } from 'vitest';\n@@\n import {\n@@\n } from './machine-discovery-e2e-control';\n+import { loadMachineDiscoveryE2EHostConfig } from './machine-discovery-e2e-host';\n@@\n     it('rejects production session credentials after reset and never returns them to the app', async () => {\n@@\n         ).rejects.toThrow('fixture session');\n     });\n+\n+    it('fails closed unless the runnable host has explicit test fixture gates', () => {\n+        const valid = {\n+            API_PORT: '3000',\n+            APP_ENV: 'test',\n+            MACHINE_DISCOVERY_E2E_ALLOWED_ORIGINS: FIXTURE_ORIGIN,\n+            MACHINE_DISCOVERY_E2E_BUILD_VARIANT: 'machine-discovery-e2e',\n+            MACHINE_DISCOVERY_E2E_CONTROL_CREDENTIAL: CONTROL_CREDENTIAL.value,\n+            MACHINE_DISCOVERY_E2E_ORIGIN: FIXTURE_ORIGIN,\n+            MACHINE_DISCOVERY_E2E_PRODUCTION_DISTRIBUTABLE: 'false',\n+            MACHINE_FIXTURE_MODE: 'true',\n+            MACHINE_GATEWAY_MODE: 'emulator',\n+            NODE_ENV: 'test',\n+        } satisfies NodeJS.ProcessEnv;\n+\n+        expect(loadMachineDiscoveryE2EHostConfig(valid)).toEqual({\n+            allowedFixtureOrigins: [FIXTURE_ORIGIN],\n+            controlCredential: CONTROL_CREDENTIAL.value,\n+            fixtureOrigin: FIXTURE_ORIGIN,\n+            port: 3000,\n+        });\n+        expect(() => loadMachineDiscoveryE2EHostConfig({ ...valid, APP_ENV: 'production' })).toThrow(\n+            'non-production',\n+        );\n+        expect(() =>\n+            loadMachineDiscoveryE2EHostConfig({ ...valid, MACHINE_DISCOVERY_E2E_PRODUCTION_DISTRIBUTABLE: 'true' }),\n+        ).toThrow('non-production');\n+    });\n+\n+    it('keeps all E2E routes and modules outside the production API build graph', () => {\n+        const apiRoot = resolve(__dirname, '../../..');\n+        const appModule = readFileSync(resolve(apiRoot, 'src/app.module.ts'), 'utf8');\n+        const buildConfig = JSON.parse(readFileSync(resolve(apiRoot, 'tsconfig.build.json'), 'utf8')) as {\n+            exclude: string[];\n+        };\n+        const packageManifest = JSON.parse(readFileSync(resolve(apiRoot, 'package.json'), 'utf8')) as {\n+            scripts: Record<string, string>;\n+        };\n+\n+        expect(appModule).not.toMatch(/machine-discovery-e2e|__e2e/);\n+        expect(buildConfig.exclude).toContain('test');\n+        expect(packageManifest.scripts.start).toBe('node dist/main.js');\n+        expect(packageManifest.scripts['machine-discovery:e2e']).toContain('test/machines/support');\n+    });\n });\n*** End Patch";
text(await tools.apply_patch(patch));
