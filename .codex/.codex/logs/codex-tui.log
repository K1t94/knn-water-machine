2026-08-12T15:14:15.430433Z  INFO session_loop{thread_id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420}:submission_dispatch{otel.name="op.dispatch.user_input" submission.id="019ff681-24e1-7df0-bb8d-b439c1fc10a6" codex.op="user_input"}:turn{otel.name="session_task.turn" thread.id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420 turn.id=019ff681-24e1-7df0-bb8d-b439c1fc10a6 model=gpt-5.6-sol codex.turn.reasoning_effort=medium}: codex_core::stream_events_utils: ToolCall: exec const patch = "*** Begin Patch\n*** Delete File: apps/mobile/src/navigation/referral-link-coordinator.spec.ts\n*** Add File: apps/mobile/src/navigation/referral-link-coordinator.spec.ts\n+import { describe, expect, it, vi } from 'vitest';\n+\n+import { SessionStore } from '../auth/stores/session.store';\n+import { FeatureAvailabilityStore } from '../features/stores/feature-availability.store';\n+\n+import { ReferralLinkCoordinator, type ReferralLinkSource } from './referral-link-coordinator';\n+\n+class TestLinkSource implements ReferralLinkSource {\n+    private listener: ((url: string) => void) | undefined;\n+    constructor(private readonly initialUrl: string | null) {}\n+    getInitialUrl(): Promise<string | null> { return Promise.resolve(this.initialUrl); }\n+    subscribe(listener: (url: string) => void): () => void {\n+        this.listener = listener;\n+        return () => { if (this.listener === listener) this.listener = undefined; };\n+    }\n+    emit(url: string): void { this.listener?.(url); }\n+}\n+\n+describe('ReferralLinkCoordinator', () => {\n+    it('accepts editable anonymous promo context only while enabled', async () => {\n+        const source = new TestLinkSource('kaynann://register?promo=firstcode123');\n+        const session = anonymousSession();\n+        const availability = enabledAvailability();\n+        const commands = { setPendingPromoCode: vi.fn(), removePendingPromoCode: vi.fn() };\n+        const coordinator = new ReferralLinkCoordinator(session, availability, source);\n+        coordinator.bindRegistration(commands);\n+\n+        await vi.waitFor(() => expect(commands.setPendingPromoCode).toHaveBeenCalledWith('FIRSTCODE123'));\n+        source.emit('kaynann://register?promo=secondcode12');\n+        expect(commands.setPendingPromoCode).toHaveBeenLastCalledWith('SECONDCODE12');\n+        availability.disableFromReferralResponse();\n+        expect(commands.removePendingPromoCode).toHaveBeenCalledOnce();\n+        source.emit('kaynann://register?promo=ignoredcode1');\n+        expect(commands.setPendingPromoCode).toHaveBeenCalledTimes(2);\n+        coordinator.dispose();\n+    });\n+\n+    it.each(['unknown', 'disabled'] as const)('does not retain links while %s', async (state) => {\n+        const source = new TestLinkSource('kaynann://register?promo=ignoredcode1');\n+        const availability = new FeatureAvailabilityStore();\n+        if (state === 'disabled') availability.finishRefresh(availability.beginRefresh(), false);\n+        const commands = { setPendingPromoCode: vi.fn(), removePendingPromoCode: vi.fn() };\n+        const coordinator = new ReferralLinkCoordinator(anonymousSession(), availability, source);\n+        coordinator.bindRegistration(commands);\n+        await Promise.resolve();\n+        availability.finishRefresh(availability.beginRefresh(), true);\n+        coordinator.bindRegistration(commands);\n+        expect(commands.setPendingPromoCode).not.toHaveBeenCalled();\n+        coordinator.dispose();\n+    });\n+\n+    it('unconditionally ignores signed-in referral links', async () => {\n+        const source = new TestLinkSource('kaynann://register?promo=signedincode1');\n+        const session = anonymousSession();\n+        session.authenticate(credentials());\n+        const commands = { setPendingPromoCode: vi.fn(), removePendingPromoCode: vi.fn() };\n+        const coordinator = new ReferralLinkCoordinator(session, enabledAvailability(), source);\n+        coordinator.bindRegistration(commands);\n+        source.emit('kaynann://register?promo=secondcode12');\n+        await Promise.resolve();\n+        expect(commands.setPendingPromoCode).not.toHaveBeenCalled();\n+        coordinator.dispose();\n+    });\n+});\n+\n+function anonymousSession(): SessionStore { const store = new SessionStore(); store.markAnonymous(); return store; }\n+function enabledAvailability(): FeatureAvailabilityStore {\n+    const store = new FeatureAvailabilityStore();\n+    store.finishRefresh(store.beginRefresh(), true);\n+    return store;\n+}\n+function credentials() {\n+    return { accessToken: 'access', accessExpiresAt: '2030-01-01T00:00:00.000Z', refreshToken: 'refresh', refreshExpiresAt: '2030-02-01T00:00:00.000Z' };\n+}\n*** Delete File: apps/mobile/src/referral/services/referral-flow.service.spec.ts\n*** Add File: apps/mobile/src/referral/services/referral-flow.service.spec.ts\n+import { Subject, of, throwError } from 'rxjs';\n+import { describe, expect, it, vi } from 'vitest';\n+\n+import { ReferralApiError } from '../../api/referral-api';\n+import { SessionStore } from '../../auth/stores/session.store';\n+import { FeatureAvailabilityStore } from '../../features/stores/feature-availability.store';\n+import { ReferralStore } from '../stores/referral.store';\n+\n+import { ReferralFlowService } from './referral-flow.service';\n+\n+import type { ReferralApi, MyReferral, ReferralInvitationPage } from '../../api/referral-api';\n+import type { Observable } from 'rxjs';\n+\n+describe('ReferralFlowService', () => {\n+    it('loads only for an authenticated session while enabled', () => {\n+        const session = new SessionStore();\n+        const availability = enabledAvailability();\n+        const store = new ReferralStore();\n+        const api = createApi();\n+        const flow = new ReferralFlowService(store, api, session, access(session), availability);\n+        expect(api.getMe).not.toHaveBeenCalled();\n+        session.authenticate(credentials('token'));\n+        expect(store.myReferral?.promoCode).toBe('23456789ABCD');\n+        availability.disableFromReferralResponse();\n+        expect(store.myReferral).toBeUndefined();\n+        expect('applyPromoCode' in flow).toBe(false);\n+        flow.dispose();\n+    });\n+\n+    it('publishes FEATURE_DISABLED globally and rejects stale data', () => {\n+        const session = new SessionStore();\n+        session.authenticate(credentials('token'));\n+        const availability = enabledAvailability();\n+        const store = new ReferralStore();\n+        const me = new Subject<MyReferral>();\n+        const invitations = new Subject<ReferralInvitationPage>();\n+        const api = createApi({ getMe: vi.fn(() => me), getInvitations: vi.fn(() => invitations) });\n+        const flow = new ReferralFlowService(store, api, session, access(session), availability);\n+        me.error(new ReferralApiError('FEATURE_DISABLED', false));\n+        expect(availability.state).toBe('disabled');\n+        expect(store.myReferral).toBeUndefined();\n+        invitations.next(page());\n+        expect(store.myReferral).toBeUndefined();\n+        flow.dispose();\n+    });\n+\n+    it('keeps ordinary retryable errors local and reloads on retry', () => {\n+        const session = new SessionStore();\n+        session.authenticate(credentials('token'));\n+        const api = createApi({ getMe: vi.fn().mockReturnValueOnce(throwError(() => new ReferralApiError('OFFLINE', true))).mockReturnValue(of(summary())) });\n+        const store = new ReferralStore();\n+        const flow = new ReferralFlowService(store, api, session, access(session), enabledAvailability());\n+        expect(store.error).toEqual({ code: 'OFFLINE', retryable: true });\n+        flow.retry();\n+        expect(store.myReferral).toEqual(summary());\n+        flow.dispose();\n+    });\n+});\n+\n+function createApi(overrides: Partial<ReferralApi> = {}): ReferralApi {\n+    return { getMe: vi.fn(() => of(summary())), getInvitations: vi.fn(() => of(page())), ...overrides };\n+}\n+function access(session: SessionStore) { return { withAccess<T>(request: (token: string) => Observable<T>) { return request(session.accessToken ?? ''); } }; }\n+function enabledAvailability(): FeatureAvailabilityStore { const store = new FeatureAvailabilityStore(); store.finishRefresh(store.beginRefresh(), true); return store; }\n+function credentials(accessToken: string) { return { accessToken, accessExpiresAt: '2099-01-01T00:15:00.000Z', refreshToken: 'refresh', refreshExpiresAt: '2099-03-01T00:00:00.000Z' }; }\n+function summary(): MyReferral { return { promoCode: '23456789ABCD', referralLink: 'kaynann://register?promo=23456789ABCD', currentInviterRewardMl: '5000', creditedInviterBonusMl: '5000', creditedInvitationCount: 1 }; }\n+function page(): ReferralInvitationPage { return { items: [], nextCursor: null, hasMore: false }; }\n*** Delete File: apps/mobile/src/navigation/MainNavigator.spec.tsx\n*** Add File: apps/mobile/src/navigation/MainNavigator.spec.tsx\n+import { fireEvent, render } from '@testing-library/react-native';\n+import { describe, expect, it, vi } from 'vitest';\n+\n+import { FeatureAvailabilityStore } from '../features/stores/feature-availability.store';\n+import { ReferralStore } from '../referral/stores/referral.store';\n+import { WalletStore } from '../wallet/stores/wallet.store';\n+\n+import { MainNavigator, mainNavigationRef } from './MainNavigator';\n+\n+import type { ReferralCompositionRoot } from '../referral/referral-composition-root';\n+import type { WalletCompositionRoot } from '../wallet/wallet-composition-root';\n+\n+describe('MainNavigator', () => {\n+    it('shows the referral entry only while availability is enabled', async () => {\n+        const referral = referralRoot(true);\n+        const navigate = vi.spyOn(mainNavigationRef, 'navigate').mockImplementation(() => undefined);\n+        const view = await render(<MainNavigator onLogout={vi.fn()} referral={referral} wallet={walletRoot()} />);\n+        await fireEvent.press(view.getByLabelText('Ouvrir le parrainage'));\n+        expect(navigate).toHaveBeenCalledWith('Referral');\n+        referral.availability.disableFromReferralResponse();\n+        expect(view.queryByLabelText('Ouvrir le parrainage')).toBeNull();\n+        navigate.mockRestore();\n+    });\n+\n+    it.each([false, undefined])('does not declare referral UI when enabled is %s', async (enabled) => {\n+        const referral = referralRoot(enabled === true);\n+        if (enabled === undefined) referral.availability.resetForSessionReplacement();\n+        const view = await render(<MainNavigator onLogout={vi.fn()} referral={referral} wallet={walletRoot()} />);\n+        expect(view.queryByLabelText('Ouvrir le parrainage')).toBeNull();\n+    });\n+});\n+\n+function walletRoot(): WalletCompositionRoot {\n+    const store = new WalletStore();\n+    const token = store.beginInitialLoad();\n+    store.finishInitialLoad(token, { balanceMl: '0', balanceLiters: '0.000', observedAt: '2026-08-10T10:00:00.000Z' }, { items: [], nextCursor: null, hasMore: false });\n+    return { store, flow: { retry: vi.fn(), refresh: vi.fn(), loadNextPage: vi.fn() } } as unknown as WalletCompositionRoot;\n+}\n+function referralRoot(enabled: boolean): ReferralCompositionRoot {\n+    const availability = new FeatureAvailabilityStore();\n+    availability.finishRefresh(availability.beginRefresh(), enabled);\n+    return { availability, store: new ReferralStore(), flow: { retry: vi.fn(), refresh: vi.fn(), loadNextPage: vi.fn() }, nativeActions: { copyPromoCode: vi.fn(), shareReferralLink: vi.fn() }, linkCoordinator: {} } as unknown as ReferralCompositionRoot;\n+}\n*** End Patch";
text(await tools.apply_patch(patch));
