,\n+  POSTGRES_DB: 'kaynann',\n+  POSTGRES_USER: 'kaynann',\n+  POSTGRES_PASSWORD: 'local_dev_only_not_for_production',\n+  DATABASE_URL: 'postgresql://kaynann:local_dev_only_not_for_production@localhost:5432/kaynann?schema=public',\n+  REDIS_URL: 'redis://localhost:6379',\n+  MQTT_URL: 'mqtt://localhost:1883',\n+  MQTT_CLIENT_ID: 'kaynann-api-local',\n+};\n+\n+for (const [key, value] of Object.entries(expected)) {\n+  if (entries.get(key) !== value) {\n+    errors.push(`${file}: ${key} must use the documented local placeholder`);\n+  }\n+}\n+\n+if (errors.length > 0) {\n+  console.error(['Environment example check failed:', ...errors.map((error) => `- ${error}`)].join('\\n'));\n+  process.exit(1);\n+}\n+\n+console.log('Environment example check passed: local placeholders only.');\n*** Add File: /Users/k1t94/Work/Projects/kaynann/knn-water-vending/scripts/check-repo-bootstrap.mjs\n+import { readFile } from 'node:fs/promises';\n+import { access } from 'node:fs/promises';\n+\n+const requiredPaths = [\n+  'apps/api/src/main.ts',\n+  'apps/api/src/health/health.controller.ts',\n+  'apps/api/src/config/env.ts',\n+  'apps/api/prisma/schema.prisma',\n+  'apps/api/prisma/migrations/20260722000000_bootstrap/migration.sql',\n+  'apps/mobile/index.ts',\n+  'apps/mobile/src/App.tsx',\n+  'apps/mobile/__tests__/App.test.tsx',\n+  'infra/compose.yaml',\n+  'infra/mosquitto/mosquitto.conf',\n+  'scripts/verify-startup.mjs',\n+  'scripts/mobile-doctor.mjs',\n+  'docs/local-development.md',\n+  'specs/000-project-onboarding/repo-map.md',\n+  '.env.example',\n+];\n+const requiredScripts = [\n+  'services:up',\n+  'services:down',\n+  'db:migrate',\n+  'dev',\n+  'dev:api',\n+  'dev:mobile',\n+  'verify:start',\n+  'lint',\n+  'typecheck',\n+  'test',\n+  'build:api',\n+  'build:mobile:js',\n+  'check:env',\n+  'check:repo',\n+];\n+const ignoredPaths = ['.env', 'apps/api/dist', 'apps/mobile/dist', 'node_modules', 'coverage'];\n+\n+const errors = [];\n+const rootPackage = JSON.parse(await readFile('package.json', 'utf8'));\n+const gitignore = await readFile('.gitignore', 'utf8');\n+const repoMap = await readFile('specs/000-project-onboarding/repo-map.md', 'utf8');\n+\n+for (const path of requiredPaths) {\n+  try {\n+    await access(path);\n+  } catch {\n+    errors.push(`missing required path: ${path}`);\n+  }\n+}\n+\n+for (const script of requiredScripts) {\n+  if (typeof rootPackage.scripts?.[script] !== 'string') {\n+    errors.push(`missing root script: ${script}`);\n+  }\n+}\n+\n+for (const path of ignoredPaths) {\n+  const probe = path === '.env' ? '.env' : `${path}/.bootstrap-ignore-probe`;\n+  if (!gitignore.includes(path) && !(path === 'node_modules' && gitignore.includes('node_modules/'))) {\n+    errors.push(`missing ignore rule: ${path}`);\n+  }\n+  const result = await import('node:child_process').then(({ execFileSync }) => {\n+    try {\n+      execFileSync('git', ['check-ignore', '-q', probe]);\n+      return true;\n+    } catch {\n+      return false;\n+    }\n+  });\n+  if (!result) errors.push(`path is not ignored by git: ${probe}`);\n+}\n+\n+for (const marker of ['apps/api/src/main.ts', 'apps/mobile/index.ts', 'infra/compose.yaml', 'pnpm verify:start']) {\n+  if (!repoMap.includes(marker)) errors.push(`repo map is missing factual marker: ${marker}`);\n+}\n+\n+if (errors.length > 0) {\n+  console.error(['Repository bootstrap check failed:', ...errors.map((error) => `- ${error}`)].join('\\n'));\n+  process.exit(1);\n+}\n+\n+console.log('Repository bootstrap check passed: paths, commands, map, and ignore rules are present.');\n*** Update File: /Users/k1t94/Work/Projects/kaynann/knn-water-vending/package.json\n@@\n     \"verify:start\": \"node scripts/verify-startup.mjs\",\n     \"mobile:doctor\": \"node scripts/mobile-doctor.mjs\",\n-    \"mobile:prebuild\": \"pnpm --filter @kaynann/mobile prebuild\"\n+    \"mobile:prebuild\": \"pnpm --filter @kaynann/mobile prebuild\",\n+    \"check:env\": \"node scripts/check-env-example.mjs\",