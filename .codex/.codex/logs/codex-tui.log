2026-08-12T15:09:14.317487Z  INFO session_loop{thread_id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420}:submission_dispatch{otel.name="op.dispatch.user_input" submission.id="019ff681-24e1-7df0-bb8d-b439c1fc10a6" codex.op="user_input"}:turn{otel.name="session_task.turn" thread.id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420 turn.id=019ff681-24e1-7df0-bb8d-b439c1fc10a6 model=gpt-5.6-sol codex.turn.reasoning_effort=medium}: codex_core::stream_events_utils: ToolCall: exec const patch = "*** Begin Patch\n*** Add File: apps/mobile/src/api/app-config-api.spec.ts\n+import { Observable, firstValueFrom } from 'rxjs';\n+import { describe, expect, it, vi } from 'vitest';\n+\n+import { FetchAppConfigApi } from './app-config-api';\n+\n+describe('FetchAppConfigApi', () => {\n+    it('is cold and strictly shapes the privacy-safe response', async () => {\n+        const fetcher = vi.fn(async () => response({ features: { referralProgramEnabled: true } })) as unknown as typeof fetch;\n+        const api = new FetchAppConfigApi('https://api.example.test', 1_000, fetcher);\n+\n+        const request$ = api.getConfig();\n+        expect(request$).toBeInstanceOf(Observable);\n+        expect(fetcher).not.toHaveBeenCalled();\n+        await expect(firstValueFrom(request$)).resolves.toEqual({ features: { referralProgramEnabled: true } });\n+        expect(fetcher).toHaveBeenCalledWith(\n+            'https://api.example.test/v1/app-config',\n+            expect.objectContaining({ headers: { accept: 'application/json' }, method: 'GET' }),\n+        );\n+    });\n+\n+    it.each([\n+        { features: { referralProgramEnabled: true }, operatorToken: 'secret' },\n+        { features: { referralProgramEnabled: true, updatedBy: 'operator' } },\n+        { features: { referralProgramEnabled: 'true' } },\n+    ])('rejects extra, private, and malformed fields', async (payload) => {\n+        const fetcher = vi.fn(async () => response(payload)) as unknown as typeof fetch;\n+        const api = new FetchAppConfigApi('https://api.example.test', 1_000, fetcher);\n+        await expect(firstValueFrom(api.getConfig())).rejects.toMatchObject({ code: 'INVALID_RESPONSE' });\n+    });\n+\n+    it('aborts the request on teardown', () => {\n+        let signal: AbortSignal | undefined;\n+        const fetcher = vi.fn((...[, init]: Parameters<typeof fetch>) => {\n+            signal = init?.signal ?? undefined;\n+            return new Promise<Response>(() => undefined);\n+        }) as unknown as typeof fetch;\n+        const subscription = new FetchAppConfigApi('https://api.example.test', 1_000, fetcher)\n+            .getConfig()\n+            .subscribe();\n+\n+        expect(signal?.aborted).toBe(false);\n+        subscription.unsubscribe();\n+        expect(signal?.aborted).toBe(true);\n+    });\n+});\n+\n+function response(payload: unknown, status = 200): Response {\n+    return { ok: status >= 200 && status < 300, status, json: async () => payload } as Response;\n+}\n*** Add File: apps/mobile/src/features/stores/feature-availability.store.spec.ts\n+import { describe, expect, it } from 'vitest';\n+\n+import { FeatureAvailabilityStore } from './feature-availability.store';\n+\n+describe('FeatureAvailabilityStore', () => {\n+    it('fails closed through unknown, loading, disabled, and error states', () => {\n+        const store = new FeatureAvailabilityStore();\n+        expect(store.referralUiVisible).toBe(false);\n+        const disabled = store.beginRefresh();\n+        expect(store.state).toBe('loading');\n+        store.finishRefresh(disabled, false);\n+        expect(store.state).toBe('disabled');\n+        const failed = store.beginRefresh();\n+        store.failRefresh(failed, { code: 'OFFLINE', retryable: true });\n+        expect(store.state).toBe('error');\n+        expect(store.referralUiVisible).toBe(false);\n+    });\n+\n+    it('publishes enabled state without exposing a revision and rejects stale refreshes', () => {\n+        const store = new FeatureAvailabilityStore();\n+        const stale = store.beginRefresh();\n+        const current = store.beginRefresh();\n+        store.finishRefresh(stale, true);\n+        expect(store.state).toBe('loading');\n+        store.finishRefresh(current, true);\n+        expect(store.referralUiVisible).toBe(true);\n+        expect('revision' in store).toBe(false);\n+    });\n+\n+    it('atomically fails closed on FEATURE_DISABLED and session replacement', () => {\n+        const store = new FeatureAvailabilityStore();\n+        store.finishRefresh(store.beginRefresh(), true);\n+        store.disableFromReferralResponse();\n+        expect(store.state).toBe('disabled');\n+        expect(store.error).toBeUndefined();\n+        store.resetForSessionReplacement();\n+        expect(store.state).toBe('unknown');\n+        expect(store.referralUiVisible).toBe(false);\n+    });\n+});\n*** Add File: apps/mobile/src/features/services/feature-availability.service.spec.ts\n+import { Subject, of, throwError } from 'rxjs';\n+import { describe, expect, it, vi } from 'vitest';\n+\n+import { AppConfigApiError } from '../../api/app-config-api';\n+import { SessionStore } from '../../auth/stores/session.store';\n+import { FeatureAvailabilityStore } from '../stores/feature-availability.store';\n+\n+import { FeatureAvailabilityService } from './feature-availability.service';\n+\n+import type { AppConfigApi, PublicAppConfig } from '../../api/app-config-api';\n+\n+describe('FeatureAvailabilityService', () => {\n+    it('loads, retries, and publishes authoritative availability', () => {\n+        const session = new SessionStore();\n+        const store = new FeatureAvailabilityStore();\n+        const getConfig = vi\n+            .fn<AppConfigApi['getConfig']>()\n+            .mockReturnValueOnce(throwError(() => new AppConfigApiError('OFFLINE', true)))\n+            .mockReturnValueOnce(of(config(false)));\n+        const service = new FeatureAvailabilityService(store, { getConfig }, session);\n+        expect(store.state).toBe('error');\n+        service.retry();\n+        expect(store.state).toBe('disabled');\n+        service.dispose();\n+    });\n+\n+    it('cancels stale refreshes and refreshes on session replacement', () => {\n+        const session = new SessionStore();\n+        const store = new FeatureAvailabilityStore();\n+        const first = new Subject<PublicAppConfig>();\n+        const second = new Subject<PublicAppConfig>();\n+        const getConfig = vi\n+            .fn<AppConfigApi['getConfig']>()\n+            .mockReturnValueOnce(first)\n+            .mockReturnValueOnce(second)\n+            .mockReturnValue(of(config(true)));\n+        const service = new FeatureAvailabilityService(store, { getConfig }, session);\n+        const firstClosed = vi.fn();\n+        first.subscribe({ complete: firstClosed });\n+        service.refresh();\n+        first.next(config(true));\n+        expect(store.state).toBe('loading');\n+        second.next(config(false));\n+        expect(store.state).toBe('disabled');\n+\n+        session.markAnonymous();\n+        expect(getConfig).toHaveBeenCalledTimes(3);\n+        expect(store.state).toBe('enabled');\n+        service.dispose();\n+        expect(store.state).toBe('unknown');\n+        service.refresh();\n+        expect(getConfig).toHaveBeenCalledTimes(3);\n+    });\n+});\n+\n+function config(enabled: boolean): PublicAppConfig {\n+    return { features: { referralProgramEnabled: enabled } };\n+}\n*** End Patch";
text(await tools.apply_patch(patch));
