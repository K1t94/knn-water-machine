2026-08-12T14:19:23.974287Z  INFO session_loop{thread_id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420}:submission_dispatch{otel.name="op.dispatch.user_input" submission.id="019ff653-3615-7440-a4a4-417a132a7875" codex.op="user_input"}:turn{otel.name="session_task.turn" thread.id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420 turn.id=019ff653-3615-7440-a4a4-417a132a7875 model=gpt-5.6-sol codex.turn.reasoning_effort=medium}: codex_core::stream_events_utils: ToolCall: exec const patch = "*** Begin Patch\n*** Add File: /Users/k1t94/Work/Projects/kaynann/knn-water-machine/scripts/set-referral-feature.mjs\n+const FEATURE_PATH = '/internal/feature-flags/referral-program';\n+\n+export async function setReferralFeature(\n+    target,\n+    {\n+        env = process.env,\n+        fetchImpl = globalThis.fetch,\n+        output = process.stdout,\n+    } = {},\n+) {\n+    if (target !== 'enabled' && target !== 'disabled') {\n+        throw new Error('Usage: set-referral-feature.mjs <enabled|disabled>');\n+    }\n+\n+    const apiUrl = requiredEnv(env, 'REFERRAL_OPERATIONS_API_URL');\n+    const token = requiredEnv(env, 'REFERRAL_OPERATIONS_TOKEN');\n+    const endpoint = new URL(FEATURE_PATH, ensureTrailingSlash(apiUrl));\n+    const enabled = target === 'enabled';\n+\n+    await requestState(fetchImpl, endpoint, token, {\n+        method: 'PUT',\n+        body: JSON.stringify({ enabled }),\n+    });\n+    const state = await requestState(fetchImpl, endpoint, token, { method: 'GET' });\n+    if (state.enabled !== enabled) {\n+        throw new Error(`Referral feature verification failed: expected enabled=${enabled}.`);\n+    }\n+\n+    output.write(`Referral feature is ${enabled ? 'enabled' : 'disabled'} (revision ${state.revision}).\\n`);\n+    return state;\n+}\n+\n+async function requestState(fetchImpl, endpoint, token, init) {\n+    let response;\n+    try {\n+        response = await fetchImpl(endpoint, {\n+            ...init,\n+            headers: {\n+                Authorization: `Bearer ${token}`,\n+                ...(init.body === undefined ? {} : { 'Content-Type': 'application/json' }),\n+            },\n+        });\n+    } catch {\n+        throw new Error('Referral feature operation failed: server is unreachable.');\n+    }\n+\n+    if (!response.ok) {\n+        throw new Error(`Referral feature operation failed with HTTP ${response.status}.`);\n+    }\n+\n+    let state;\n+    try {\n+        state = await response.json();\n+    } catch {\n+        throw new Error('Referral feature operation returned malformed JSON.');\n+    }\n+    if (!isFeatureState(state)) {\n+        throw new Error('Referral feature operation returned an invalid state.');\n+    }\n+    return state;\n+}\n+\n+function isFeatureState(value) {\n+    return (\n+        typeof value === 'object' &&\n+        value !== null &&\n+        value.key === 'REFERRAL_PROGRAM' &&\n+        typeof value.enabled === 'boolean' &&\n+        typeof value.revision === 'string' &&\n+        /^\\d+$/.test(value.revision) &&\n+        typeof value.updatedAt === 'string' &&\n+        !Number.isNaN(Date.parse(value.updatedAt))\n+    );\n+}\n+\n+function requiredEnv(env, name) {\n+    const value = env[name]?.trim();\n+    if (!value) throw new Error(`${name} is required.`);\n+    return value;\n+}\n+\n+function ensureTrailingSlash(value) {\n+    return value.endsWith('/') ? value : `${value}/`;\n+}\n+\n+if (process.argv[1] && import.meta.url === new URL(`file://${process.argv[1]}`).href) {\n+    setReferralFeature(process.argv[2]).catch((error) => {\n+        process.stderr.write(`${error instanceof Error ? error.message : 'Referral feature operation failed.'}\\n`);\n+        process.exitCode = 1;\n+    });\n+}\n*** Add File: /Users/k1t94/Work/Projects/kaynann/knn-water-machine/scripts/set-referral-feature.test.mjs\n+import assert from 'node:assert/strict';\n+import test from 'node:test';\n+\n+import { setReferralFeature } from './set-referral-feature.mjs';\n+\n+const token = 'secret-value-that-must-never-be-printed';\n+const env = {\n+    REFERRAL_OPERATIONS_API_URL: 'https://api.example.test',\n+    REFERRAL_OPERATIONS_TOKEN: token,\n+};\n+\n+test('requires URL and token environment variables', async () => {\n+    await assert.rejects(() => setReferralFeature('enabled', { env: {}, fetchImpl: fetch }), /API_URL is required/);\n+    await assert.rejects(\n+        () => setReferralFeature('enabled', { env: { REFERRAL_OPERATIONS_API_URL: env.REFERRAL_OPERATIONS_API_URL }, fetchImpl: fetch }),\n+        /TOKEN is required/,\n+    );\n+});\n+\n+test('performs PUT then GET and verifies enabled and disabled states', async () => {\n+    for (const target of ['enabled', 'disabled']) {\n+        const calls = [];\n+        const output = bufferOutput();\n+        const expected = target === 'enabled';\n+        const fetchImpl = async (url, init) => {\n+            calls.push({ url: String(url), init });\n+            return jsonResponse({\n+                key: 'REFERRAL_PROGRAM',\n+                enabled: expected,\n+                revision: '4',\n+                updatedAt: '2026-08-12T12:00:00.000Z',\n+            });\n+        };\n+        await setReferralFeature(target, { env, fetchImpl, output });\n+        assert.deepEqual(calls.map(({ init }) => init.method), ['PUT', 'GET']);\n+        assert.equal(calls[0].init.body, JSON.stringify({ enabled: expected }));\n+        assert.match(output.value, new RegExp(target));\n+        assert.doesNotMatch(output.value, new RegExp(token));\n+    }\n+});\n+\n+test('fails on non-2xx, malformed responses, mismatch, and network errors without exposing token', async () => {\n+    const cases = [\n+        async () => new Response('{}', { status: 401 }),\n+        async () => new Response('not-json', { status: 200 }),\n+        async () => jsonResponse({ key: 'wrong' }),\n+        async () => {\n+            throw new Error(token);\n+        },\n+    ];\n+    for (const fetchImpl of cases) {\n+        await assert.rejects(\n+            () => setReferralFeature('enabled', { env, fetchImpl, output: bufferOutput() }),\n+            (error) => error instanceof Error && !error.message.includes(token),\n+        );\n+    }\n+\n+    let call = 0;\n+    await assert.rejects(\n+        () => setReferralFeature('enabled', {\n+            env,\n+            output: bufferOutput(),\n+            fetchImpl: async () => jsonResponse({\n+                key: 'REFERRAL_PROGRAM',\n+                enabled: call++ === 0,\n+                revision: '5',\n+                updatedAt: '2026-08-12T12:00:00.000Z',\n+            }),\n+        }),\n+        /verification failed/,\n+    );\n+});\n+\n+function jsonResponse(body) {\n+    return new Response(JSON.stringify(body), { status: 200, headers: { 'Content-Type': 'application/json' } });\n+}\n+\n+function bufferOutput() {\n+    return {\n+        value: '',\n+        write(value) {\n+            this.value += value;\n+        },\n+    };\n+}\n*** Update File: /Users/k1t94/Work/Projects/kaynann/knn-water-machine/package.json\n@@\n         \"mobile:prebuild\": \"pnpm --filter @kaynann/mobile prebuild\",\n+        \"referral:enable\": \"node scripts/set-referral-feature.mjs enabled\",\n+        \"referral:disable\": \"node scripts/set-referral-feature.mjs disabled\",\n         \"check:env\": \"node scripts/check-env-example.mjs\",\n*** End Patch";
text(await tools.apply_patch(patch)); thread_id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420
