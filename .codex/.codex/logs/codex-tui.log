2026-08-12T11:52:36.579938Z  INFO session_loop{thread_id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420}:submission_dispatch{otel.name="op.dispatch.user_input" submission.id="019ff5cb-4a37-7b72-9194-6436615e7fb6" codex.op="user_input"}:turn{otel.name="session_task.turn" thread.id=019ff5ad-b076-7e13-9fc1-4c2a2ad98420 turn.id=019ff5cb-4a37-7b72-9194-6436615e7fb6 model=gpt-5.6-sol codex.turn.reasoning_effort=medium}: codex_core::stream_events_utils: ToolCall: exec const patch = "*** Begin Patch\n*** Delete File: specs/005-referral-program/contracts/openapi.yaml\n*** Add File: specs/005-referral-program/contracts/openapi.yaml\n+openapi: 3.1.0\n+info:\n+  title: Kaynann Referral Public API\n+  version: 0.2.0\n+  description: Public availability and authenticated inviter-only referral reads.\n+servers:\n+  - url: /\n+paths:\n+  /v1/app-config:\n+    get:\n+      operationId: getPublicAppConfig\n+      summary: Get privacy-safe runtime feature availability\n+      security: []\n+      responses:\n+        \"200\":\n+          description: Current authoritative public availability\n+          headers:\n+            Cache-Control:\n+              $ref: \"#/components/headers/NoStore\"\n+          content:\n+            application/json:\n+              schema:\n+                $ref: \"#/components/schemas/PublicAppConfig\"\n+        \"503\":\n+          $ref: \"#/components/responses/ServiceUnavailable\"\n+  /v1/referrals/me:\n+    get:\n+      operationId: getMyReferral\n+      summary: Get the authenticated user's referral code and inviter summary\n+      security:\n+        - bearerAuth: []\n+      responses:\n+        \"200\":\n+          description: Referral information owned by the authenticated user\n+          headers:\n+            Cache-Control:\n+              $ref: \"#/components/headers/NoStore\"\n+          content:\n+            application/json:\n+              schema:\n+                $ref: \"#/components/schemas/MyReferralResponse\"\n+        \"401\":\n+          $ref: \"#/components/responses/Unauthorized\"\n+        \"503\":\n+          $ref: \"#/components/responses/ReferralUnavailable\"\n+  /v1/referrals/invitations:\n+    get:\n+      operationId: getMyReferralInvitations\n+      summary: Get credited inviter bonus history\n+      security:\n+        - bearerAuth: []\n+      parameters:\n+        - name: limit\n+          in: query\n+          required: false\n+          schema:\n+            type: integer\n+            minimum: 1\n+            maximum: 100\n+            default: 20\n+        - name: cursor\n+          in: query\n+          required: false\n+          schema:\n+            type: string\n+            minLength: 1\n+            maxLength: 512\n+      responses:\n+        \"200\":\n+          description: Newest-first credited invitations\n+          headers:\n+            Cache-Control:\n+              $ref: \"#/components/headers/NoStore\"\n+          content:\n+            application/json:\n+              schema:\n+                $ref: \"#/components/schemas/ReferralInvitationPage\"\n+        \"400\":\n+          $ref: \"#/components/responses/BadRequest\"\n+        \"401\":\n+          $ref: \"#/components/responses/Unauthorized\"\n+        \"503\":\n+          $ref: \"#/components/responses/ReferralUnavailable\"\n+components:\n+  securitySchemes:\n+    bearerAuth:\n+      type: http\n+      scheme: bearer\n+      bearerFormat: JWT\n+  headers:\n+    NoStore:\n+      schema:\n+        type: string\n+        const: no-store\n+  schemas:\n+    PublicAppConfig:\n+      type: object\n+      additionalProperties: false\n+      required: [features]\n+      properties:\n+        features:\n+          type: object\n+          additionalProperties: false\n+          required: [referralProgramEnabled]\n+          properties:\n+            referralProgramEnabled:\n+              type: boolean\n+    MyReferralResponse:\n+      type: object\n+      additionalProperties: false\n+      required: [promoCode, referralLink, creditedInvitations, creditedBonusMl, currentInviterRewardMl]\n+      properties:\n+        promoCode:\n+          type: string\n+          minLength: 1\n+          maxLength: 12\n+        referralLink:\n+          type: string\n+          format: uri\n+        creditedInvitations:\n+          type: integer\n+          minimum: 0\n+        creditedBonusMl:\n+          $ref: \"#/components/schemas/Millilitres\"\n+        currentInviterRewardMl:\n+          $ref: \"#/components/schemas/Millilitres\"\n+    ReferralInvitation:\n+      type: object\n+      additionalProperties: false\n+      required: [id, inviteeLabel, appliedAt, status, creditedAmountMl]\n+      properties:\n+        id:\n+          type: string\n+          format: uuid\n+        inviteeLabel:\n+          type: string\n+          pattern: \"^\\\\*{3,}\\\\d{2}$\"\n+        appliedAt:\n+          type: string\n+          format: date-time\n+        status:\n+          type: string\n+          const: CREDITED\n+        creditedAmountMl:\n+          $ref: \"#/components/schemas/Millilitres\"\n+    ReferralInvitationPage:\n+      type: object\n+      additionalProperties: false\n+      required: [items, nextCursor]\n+      properties:\n+        items:\n+          type: array\n+          items:\n+            $ref: \"#/components/schemas/ReferralInvitation\"\n+        nextCursor:\n+          oneOf:\n+            - type: string\n+            - type: \"null\"\n+    Millilitres:\n+      type: string\n+      pattern: \"^[0-9]+$\"\n+      description: Exact non-negative whole millilitres encoded as a decimal string.\n+    PublicError:\n+      type: object\n+      additionalProperties: false\n+      required: [error]\n+      properties:\n+        error:\n+          type: object\n+          additionalProperties: false\n+          required: [code, message, retryable, requestId]\n+          properties:\n+            code:\n+              type: string\n+              enum: [FEATURE_DISABLED, REFERRAL_SERVICE_UNAVAILABLE, VALIDATION_FAILED, AUTHENTICATION_REQUIRED]\n+            message:\n+              type: string\n+            retryable:\n+              type: boolean\n+            requestId:\n+              type: string\n+  responses:\n+    BadRequest:\n+      description: Request validation failed\n+      content:\n+        application/json:\n+          schema:\n+            $ref: \"#/components/schemas/PublicError\"\n+    Unauthorized:\n+      description: Valid access session required\n+      content:\n+        application/json:\n+          schema:\n+            $ref: \"#/components/schemas/PublicError\"\n+    ServiceUnavailable:\n+      description: Authoritative configuration is temporarily unavailable\n+      content:\n+        application/json:\n+          schema:\n+            $ref: \"#/components/schemas/PublicError\"\n+          example:\n+            error:\n+              code: REFERRAL_SERVICE_UNAVAILABLE\n+              message: Service is temporarily unavailable.\n+              retryable: true\n+              requestId: request-id\n+    ReferralUnavailable:\n+      description: Referral feature is disabled or temporarily unavailable\n+      content:\n+        application/json:\n+          schema:\n+            $ref: \"#/components/schemas/PublicError\"\n+          examples:\n+            disabled:\n+              value:\n+                error:\n+                  code: FEATURE_DISABLED\n+                  message: Referral program is disabled.\n+                  retryable: false\n+                  requestId: request-id\n+            unavailable:\n+              value:\n+                error:\n+                  code: REFERRAL_SERVICE_UNAVAILABLE\n+                  message: Service is temporarily unavailable.\n+                  retryable: true\n+                  requestId: request-id\n*** Delete File: specs/005-referral-program/contracts/internal-referral-commands.md\n*** Add File: specs/005-referral-program/contracts/internal-referral-commands.md\n+# Internal Referral Command Contracts\n+\n+These are trusted application boundaries, not public HTTP endpoints.\n+\n+## Complete Referral Onboarding\n+\n+Called from successful registration completion inside its existing serializable Prisma transaction.\n+\n+```ts\n+interface CompleteReferralOnboardingInput {\n+  userId: string;\n+  isNewUser: boolean;\n+  pendingPromoCode: string | null;\n+  completedAt: Date;\n+  registrationCompletionId: string;\n+}\n+\n+interface CompleteReferralOnboardingResult {\n+  promoCode: string;\n+  relationshipCreated: boolean;\n+  inviterEntitlementIds: readonly string[];\n+}\n+```\n+\n+Rules:\n+\n+- Execute only after OTP, current legal acceptance, and registration completion preconditions.\n+- Lock/read authoritative availability in the same transaction before referral validation or writes.\n+- Always provision the registering user's stable promo code idempotently.\n+- Disabled/unavailable state consumes pending context and returns no relationship or entitlement without failing registration.\n+- Enabled plus no code returns no relationship or entitlement.\n+- Enabled plus valid non-self code atomically creates one `REGISTRATION` relationship and one `INVITER` entitlement.\n+- Never create welcome/invitee entitlements.\n+- Repeated or concurrent completion converges through completion identity and database uniqueness.\n+\n+## Validate Pending Registration Promo\n+\n+```ts\n+interface ValidatePendingRegistrationPromoInput {\n+  promoCode: string;\n+  prospectiveInviteeUserId?: string;\n+}\n+```\n+\n+This boundary exists only for editable registration context. It canonicalizes and returns privacy-safe unavailable/self outcomes while enabled. Disabled state must not retain the code or expose owner information. Validation never creates a relationship, entitlement, or wallet operation.\n+\n+## Read Referral Availability\n+\n+```ts\n+interface ReferralAvailability {\n+  enabled: boolean;\n+  revision: bigint;\n+  updatedAt: Date;\n+}\n+```\n+\n+Public consumers receive only the boolean. Internal business consumers use an authoritative read or transactional shared-lock assertion. Storage failure is distinct from disabled state and fails referral behavior closed.\n+\n+## Set Referral Availability\n+\n+```ts\n+interface SetReferralAvailabilityInput { enabled: boolean }\n+type SetReferralAvailabilityResult = ReferralAvailability;\n+```\n+\n+Only the protected operational controller may invoke this command. It takes an exclusive row lock. Same-value calls are idempotent and keep revision/time; transitions increment revision once.\n+\n+## Deliver Inviter Entitlement\n+\n+```ts\n+interface DeliverReferralEntitlementInput {\n+  entitlementId: string;\n+  expectedLeaseOwner?: string;\n+}\n+```\n+\n+Rules:\n+\n+- Accept only active `INVITER` entitlements; legacy `WELCOME` rows are not eligible.\n+- Claim only while enabled.\n+- Invoke a trusted wallet command that takes a shared feature-row lock inside the wallet transaction immediately before the idempotent ledger write.\n+- If disabled wins the lock order, create no ledger entry and return the entitlement to retryable pending state.\n+- Preserve the stable business-event key on every retry.\n+- Crash after wallet commit is reconciled by idempotent replay and entitlement completion after re-enable.\n+\n+## Run Referral Recovery\n+\n+```ts\n+interface ReferralRecoveryRunOptions {\n+  batchSize?: number;\n+  workerId?: string;\n+}\n+```\n+\n+While disabled, claim zero rows and perform no wallet work. After enable, expired/current due inviter obligations resume with existing `FOR UPDATE SKIP LOCKED`, leases, bounded backoff, and wallet idempotency.\n+\n+## Query Referral Data\n+\n+Authenticated query commands derive `userId` from session claims. They first require enabled authoritative state and otherwise return `FEATURE_DISABLED`. Summary contains no eligibility or attached-code state. Invitation history includes only delivered inviter entitlements and privacy-safe fields.\n+\n+## Removed Contracts\n+\n+- Post-registration apply promo code.\n+- Close referral eligibility after purchase.\n+- Create welcome entitlement.\n+- Provision eligibility.\n+- Public or internal attached-code/eligibility state.\n*** Add File: specs/005-referral-program/contracts/operational-feature-flag.openapi.yaml\n+openapi: 3.1.0\n+info:\n+  title: Kaynann Referral Operational API\n+  version: 0.1.0\n+  description: Protected internal runtime control; excluded from public Swagger output.\n+servers:\n+  - url: \"{operationsUrl}\"\n+    variables:\n+      operationsUrl:\n+        default: http://localhost:3000\n+security:\n+  - operationsBearer: []\n+paths:\n+  /internal/feature-flags/referral-program:\n+    get:\n+      operationId: getReferralProgramFeatureState\n+      responses:\n+        \"200\":\n+          description: Authoritative state\n+          headers:\n+            Cache-Control:\n+              schema: { type: string, const: no-store }\n+          content:\n+            application/json:\n+              schema: { $ref: \"#/components/schemas/ReferralFeatureState\" }\n+        \"401\": { $ref: \"#/components/responses/Unauthorized\" }\n+        \"503\": { $ref: \"#/components/responses/Unavailable\" }\n+    put:\n+      operationId: setReferralProgramFeatureState\n+      description: Idempotently set the authoritative runtime state.\n+      requestBody:\n+        required: true\n+        content:\n+          application/json:\n+            schema:\n+              type: object\n+              additionalProperties: false\n+              required: [enabled]\n+              properties:\n+                enabled: { type: boolean }\n+      responses:\n+        \"200\":\n+          description: Accepted authoritative state after the toggle boundary\n+          headers:\n+            Cache-Control:\n+              schema: { type: string, const: no-store }\n+          content:\n+            application/json:\n+              schema: { $ref: \"#/components/schemas/ReferralFeatureState\" }\n+        \"400\": { $ref: \"#/components/responses/BadRequest\" }\n+        \"401\": { $ref: \"#/components/responses/Unauthorized\" }\n+        \"503\": { $ref: \"#/components/responses/Unavailable\" }\n+components:\n+  securitySchemes:\n+    operationsBearer:\n+      type: http\n+      scheme: bearer\n+      bearerFormat: opaque-internal-token\n+  schemas:\n+    ReferralFeatureState:\n+      type: object\n+      additionalProperties: false\n+      required: [key, enabled, revision, updatedAt]\n+      properties:\n+        key: { type: string, const: REFERRAL_PROGRAM }\n+        enabled: { type: boolean }\n+        revision: { type: string, pattern: \"^[1-9][0-9]*$\" }\n+        updatedAt: { type: string, format: date-time }\n+    OperationalError:\n+      type: object\n+      additionalProperties: false\n+      required: [statusCode, message]\n+      properties:\n+        statusCode: { type: integer }\n+        message: { type: string }\n+  responses:\n+    BadRequest:\n+      description: Strict body validation failed\n+      content:\n+        application/json:\n+          schema: { $ref: \"#/components/schemas/OperationalError\" }\n+    Unauthorized:\n+      description: Missing or invalid operations credential; no state is returned\n+      content:\n+        application/json:\n+          schema: { $ref: \"#/components/schemas/OperationalError\" }\n+    Unavailable:\n+      description: Authoritative storage is unavailable\n+      content:\n+        application/json:\n+          schema: { $ref: \"#/components/schemas/OperationalError\" }\n*** End Patch";
text(await tools.apply_patch(patch));
