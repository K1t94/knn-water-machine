{
  "components": {
    "schemas": {
      "AuthErrorBodyDto": {
        "properties": {
          "code": {
            "enum": [
              "INVALID_PHONE",
              "UNSUPPORTED_COUNTRY",
              "RATE_LIMITED",
              "SMS_BUDGET_EXHAUSTED",
              "SMS_CONFIGURATION_ERROR",
              "SMS_AUTH_FAILED",
              "SMS_BALANCE_EXHAUSTED",
              "SMS_PROVIDER_RATE_LIMITED",
              "SMS_INVALID_RECIPIENT",
              "SMS_REJECTED",
              "SMS_TIMEOUT",
              "SMS_TEMPORARILY_UNAVAILABLE",
              "OTP_INVALID",
              "OTP_EXPIRED",
              "OTP_USED",
              "OTP_ATTEMPTS_EXHAUSTED",
              "REGISTRATION_AUTH_INVALID",
              "REGISTRATION_AUTH_EXPIRED",
              "LEGAL_VERSION_STALE",
              "DEPENDENCY_UNAVAILABLE",
              "SESSION_CREATION_FAILED",
              "REFRESH_INVALID",
              "REFRESH_EXPIRED",
              "REFRESH_REPLAYED"
            ],
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "maxLength": 128,
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "retryAfterSeconds": {
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "requestId"
        ],
        "type": "object"
      },
      "AuthErrorResponseDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/AuthErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "CurrentLegalSetDto": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/LegalDocumentDto"
            },
            "type": "array"
          },
          "setVersion": {
            "type": "string"
          }
        },
        "required": [
          "setVersion",
          "documents"
        ],
        "type": "object"
      },
      "LegalAcceptanceDto": {
        "properties": {
          "acceptedDocumentIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "setVersion": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "setVersion",
          "acceptedDocumentIds",
          "installationId"
        ],
        "type": "object"
      },
      "LegalDocumentDto": {
        "properties": {
          "content": {
            "type": "string"
          },
          "contentSha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "enum": [
              "TERMS_OF_SERVICE",
              "PRIVACY_POLICY"
            ],
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "version",
          "title",
          "content",
          "mandatory",
          "contentSha256"
        ],
        "type": "object"
      },
      "OrangeDeliveryInfoDto": {
        "properties": {
          "address": {
            "example": "tel:+221771234567",
            "maxLength": 32,
            "type": "string"
          },
          "deliveryStatus": {
            "enum": [
              "DeliveredToNetwork",
              "DeliveryUncertain",
              "DeliveryImpossible",
              "MessageWaiting",
              "DeliveredToTerminal"
            ],
            "type": "string"
          }
        },
        "required": [
          "address",
          "deliveryStatus"
        ],
        "type": "object"
      },
      "OrangeDeliveryReceiptDto": {
        "properties": {
          "callbackData": {
            "maxLength": 255,
            "type": "string"
          },
          "deliveryInfo": {
            "$ref": "#/components/schemas/OrangeDeliveryInfoDto"
          }
        },
        "required": [
          "callbackData",
          "deliveryInfo"
        ],
        "type": "object"
      },
      "OrangeDeliveryReceiptEnvelopeDto": {
        "properties": {
          "deliveryInfoNotification": {
            "$ref": "#/components/schemas/OrangeDeliveryReceiptDto"
          }
        },
        "required": [
          "deliveryInfoNotification"
        ],
        "type": "object"
      },
      "OtpIssuedResponseDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "delivery": {
            "enum": [
              "accepted",
              "uncertain"
            ],
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "resendAvailableAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "expiresAt",
          "resendAvailableAt",
          "delivery"
        ],
        "type": "object"
      },
      "OtpRequestDto": {
        "properties": {
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "pendingPromoCode": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          },
          "phone": {
            "example": "+221771234567",
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "phone",
          "installationId"
        ],
        "type": "object"
      },
      "OtpResendDto": {
        "properties": {
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "pendingPromoCode": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          },
          "phone": {
            "example": "+221771234567",
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "phone",
          "installationId"
        ],
        "type": "object"
      },
      "OtpVerificationDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "pattern": "^\\d{6}$",
            "type": "string",
            "writeOnly": true
          },
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "pendingPromoCode": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          },
          "phone": {
            "example": "+221771234567",
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "phone",
          "installationId",
          "challengeId",
          "code"
        ],
        "type": "object"
      },
      "OtpVerifiedResponseDto": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "nextStep": {
            "enum": [
              "authenticated",
              "completeRegistration",
              "acceptLegal"
            ],
            "type": "string"
          },
          "registrationAuthorization": {
            "maxLength": 512,
            "minLength": 32,
            "type": "string"
          },
          "session": {
            "$ref": "#/components/schemas/SessionCredentialsDto"
          }
        },
        "required": [
          "nextStep"
        ],
        "type": "object"
      },
      "RefreshSessionDto": {
        "properties": {
          "refreshToken": {
            "maxLength": 512,
            "minLength": 32,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RegistrationCompletionDto": {
        "properties": {
          "acceptedDocumentIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "setVersion": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "setVersion",
          "acceptedDocumentIds",
          "installationId"
        ],
        "type": "object"
      },
      "RegistrationContextDto": {
        "properties": {
          "pendingPromoCode": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "SessionCredentialsDto": {
        "properties": {
          "accessExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "accessToken": {
            "minLength": 1,
            "type": "string"
          },
          "refreshExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "refreshToken": {
            "minLength": 32,
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "AccessBearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "RegistrationAuth": {
        "description": "Short-lived authorization that never grants application access.",
        "in": "header",
        "name": "X-Registration-Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Generated NestJS contract snapshot for drift detection.",
