{
  "components": {
    "schemas": {
      "AppConfigResponseDto": {
        "properties": {
          "features": {
            "$ref": "#/components/schemas/PublicFeatureAvailabilityDto"
          }
        },
        "required": [
          "features"
        ],
        "type": "object"
      },
      "AuthErrorBodyDto": {
        "properties": {
          "code": {
            "enum": [
              "INVALID_PHONE",
              "UNSUPPORTED_COUNTRY",
              "RATE_LIMITED",
              "SMS_BUDGET_EXHAUSTED",
              "SMS_CONFIGURATION_ERROR",
              "SMS_AUTH_FAILED",
              "SMS_BALANCE_EXHAUSTED",
              "SMS_PROVIDER_RATE_LIMITED",
              "SMS_INVALID_RECIPIENT",
              "SMS_REJECTED",
              "SMS_TIMEOUT",
              "SMS_TEMPORARILY_UNAVAILABLE",
              "OTP_INVALID",
              "OTP_EXPIRED",
              "OTP_USED",
              "OTP_ATTEMPTS_EXHAUSTED",
              "REGISTRATION_AUTH_INVALID",
              "REGISTRATION_AUTH_EXPIRED",
              "LEGAL_VERSION_STALE",
              "REFERRAL_CODE_UNAVAILABLE",
              "REFERRAL_SELF_NOT_ALLOWED",
              "REFERRAL_ALREADY_ATTACHED",
              "REFERRAL_SERVICE_UNAVAILABLE",
              "DEPENDENCY_UNAVAILABLE",
              "SESSION_CREATION_FAILED",
              "REFRESH_INVALID",
              "REFRESH_EXPIRED",
              "REFRESH_REPLAYED"
            ],
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "maxLength": 128,
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "retryAfterSeconds": {
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "requestId"
        ],
        "type": "object"
      },
      "AuthErrorResponseDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/AuthErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "CurrentLegalSetDto": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/LegalDocumentDto"
            },
            "type": "array"
          },
          "setVersion": {
            "type": "string"
          }
        },
        "required": [
          "setVersion",
          "documents"
        ],
        "type": "object"
      },
      "LegalAcceptanceDto": {
        "properties": {
          "acceptedDocumentIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "setVersion": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "setVersion",
          "acceptedDocumentIds",
          "installationId"
        ],
        "type": "object"
      },
      "LegalDocumentDto": {
        "properties": {
          "content": {
            "type": "string"
          },
          "contentSha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "enum": [
              "TERMS_OF_SERVICE",
              "PRIVACY_POLICY"
            ],
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "version",
          "title",
          "content",
          "mandatory",
          "contentSha256"
        ],
        "type": "object"
      },
      "MyReferralResponseDto": {
        "properties": {
          "creditedInvitationCount": {
            "minimum": 0,
            "type": "number"
          },
          "creditedInviterBonusMl": {
            "example": "5000",
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "currentInviterRewardMl": {
            "example": "5000",
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "promoCode": {
            "example": "3A7K9MN2QTVW",
            "pattern": "^[23456789ABCDEFGHJKMNPQRSTVWXYZ]{12}$",
            "type": "string"
          },
          "referralLink": {
            "pattern": "^kaynann://register\\?promo=[23456789ABCDEFGHJKMNPQRSTVWXYZ]{12}$",
            "type": "string"
          }
        },
        "required": [
          "promoCode",
          "referralLink",
          "currentInviterRewardMl",
          "creditedInviterBonusMl",
          "creditedInvitationCount"
        ],
        "type": "object"
      },
      "OrangeDeliveryInfoDto": {
        "properties": {
          "address": {
            "example": "tel:+221771234567",
            "maxLength": 32,
            "type": "string"
          },
          "deliveryStatus": {
            "enum": [
              "DeliveredToNetwork",
              "DeliveryUncertain",
              "DeliveryImpossible",
              "MessageWaiting",
              "DeliveredToTerminal"
            ],
            "type": "string"
          }
        },
        "required": [
          "address",
          "deliveryStatus"
        ],
        "type": "object"
      },
      "OrangeDeliveryReceiptDto": {
        "properties": {
          "callbackData": {
            "maxLength": 255,
            "type": "string"
          },
          "deliveryInfo": {
            "$ref": "#/components/schemas/OrangeDeliveryInfoDto"
          }
        },
        "required": [
          "callbackData",
          "deliveryInfo"
        ],
        "type": "object"
      },
      "OrangeDeliveryReceiptEnvelopeDto": {
        "properties": {
          "deliveryInfoNotification": {
            "$ref": "#/components/schemas/OrangeDeliveryReceiptDto"
          }
        },
        "required": [
          "deliveryInfoNotification"
        ],
        "type": "object"
      },
      "OtpIssuedResponseDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "delivery": {
            "enum": [
              "accepted",
              "uncertain"
            ],
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "resendAvailableAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "expiresAt",
          "resendAvailableAt",
          "delivery"
        ],
        "type": "object"
      },
      "OtpRequestDto": {
        "properties": {
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "pendingPromoCode": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          },
          "phone": {
            "example": "+221771234567",
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "phone",
          "installationId"
        ],
        "type": "object"
      },
      "OtpResendDto": {
        "properties": {
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "pendingPromoCode": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          },
          "phone": {
            "example": "+221771234567",
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "phone",
          "installationId"
        ],
        "type": "object"
      },
      "OtpVerificationDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "pattern": "^\\d{6}$",
            "type": "string",
            "writeOnly": true
          },
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "pendingPromoCode": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          },
          "phone": {
            "example": "+221771234567",
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "phone",
          "installationId",
          "challengeId",
          "code"
        ],
        "type": "object"
      },
      "OtpVerifiedResponseDto": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "nextStep": {
            "enum": [
              "authenticated",
              "completeRegistration",
              "acceptLegal"
            ],
            "type": "string"
          },
          "registrationAuthorization": {
            "maxLength": 512,
            "minLength": 32,
            "type": "string"
          },
          "session": {
            "$ref": "#/components/schemas/SessionCredentialsDto"
          }
        },
        "required": [
          "nextStep"
        ],
        "type": "object"
      },
      "PublicFeatureAvailabilityDto": {
        "properties": {
          "referralProgramEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "referralProgramEnabled"
        ],
        "type": "object"
      },
      "ReferralInvitationPageResponseDto": {
        "properties": {
          "hasMore": {
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReferralInvitationResponseDto"
            },
            "maxItems": 100,
            "type": "array"
          },
          "nextCursor": {
            "maxLength": 512,
            "minLength": 1,
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "hasMore"
        ],
        "type": "object"
      },
      "ReferralInvitationResponseDto": {
        "properties": {
          "appliedAt": {
            "format": "date-time",
            "type": "string"
          },
          "creditedAmountMl": {
            "example": "5000",
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "inviteeLabel": {
            "example": "**42",
            "pattern": "^\\*\\*[0-9]{0,2}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "CREDITED"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "inviteeLabel",
          "appliedAt",
          "status",
          "creditedAmountMl"
        ],
        "type": "object"
      },
      "ReferralPublicErrorDetailsDto": {
        "properties": {
          "code": {
            "enum": [
              "FEATURE_DISABLED",
              "REFERRAL_CODE_UNAVAILABLE",
              "REFERRAL_SELF_NOT_ALLOWED",
              "REFERRAL_SERVICE_UNAVAILABLE",
              "REFERRAL_CURSOR_INVALID"
            ],
            "type": "string"
          },
          "message": {
            "maxLength": 200,
            "type": "string"
          },
          "requestId": {
            "maxLength": 128,
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "requestId"
        ],
        "type": "object"
      },
      "ReferralPublicErrorResponseDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ReferralPublicErrorDetailsDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "RefreshSessionDto": {
        "properties": {
          "refreshToken": {
            "maxLength": 512,
            "minLength": 32,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RegistrationCompletionDto": {
        "properties": {
          "acceptedDocumentIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "installationId": {
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          },
          "setVersion": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "setVersion",
          "acceptedDocumentIds",
          "installationId"
        ],
        "type": "object"
      },
      "RegistrationContextDto": {
        "properties": {
          "pendingPromoCode": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "SessionCredentialsDto": {
        "properties": {
          "accessExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "accessToken": {
            "minLength": 1,
            "type": "string"
          },
          "refreshExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "refreshToken": {
            "minLength": 32,
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "accessExpiresAt",
          "refreshToken",
          "refreshExpiresAt"
        ],
        "type": "object"
      },
      "WalletBalanceResponseDto": {
        "properties": {
          "balanceLiters": {
            "description": "Display-only litre representation with three decimals.",
            "example": "12.500",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{3}$",
            "type": "string"
          },
          "balanceMl": {
            "description": "Current water balance in exact integer millilitres.",
            "example": "12500",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "type": "string"
          },
          "observedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "balanceMl",
          "balanceLiters",
          "observedAt"
        ],
        "type": "object"
      },
      "WalletHistoryEntryResponseDto": {
        "properties": {
          "amountMl": {
            "example": "1250",
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string"
          },
          "direction": {
            "enum": [
              "CREDIT",
              "DEBIT"
            ],
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "operationKind": {
            "example": "TEST_OPERATION",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "recordedAt": {
            "format": "date-time",
            "type": "string"
          },
          "source": {
            "example": "TEST_SUITE",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "direction",
          "amountMl",
          "operationKind",
          "source",
          "occurredAt",
          "recordedAt"
        ],
        "type": "object"
      },
      "WalletHistoryResponseDto": {
        "properties": {
          "hasMore": {
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/WalletHistoryEntryResponseDto"
            },
            "maxItems": 100,
            "type": "array"
          },
          "nextCursor": {
            "maxLength": 512,
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "hasMore"
        ],
        "type": "object"
      },
      "WalletPublicErrorDetailsDto": {
        "properties": {
          "code": {
            "example": "WALLET_TEMPORARILY_UNAVAILABLE",
            "type": "string"
          },
          "message": {
            "example": "Wallet data is temporarily unavailable.",
            "type": "string"
          },
          "requestId": {
            "example": "request-id",
            "type": "string"
          },
          "retryable": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "requestId"
        ],
        "type": "object"
      },
      "WalletPublicErrorResponseDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/WalletPublicErrorDetailsDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "AccessBearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "RegistrationAuth": {
        "description": "Short-lived authorization that never grants application access.",
        "in": "header",
        "name": "X-Registration-Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Generated aggregate NestJS contract snapshot for drift detection.",
    "title": "KAYNANN API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/v1/app-config": {
      "get": {
        "operationId": "AppConfigController_getConfig",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfigResponseDto"
                }
              }
            },
            "description": "",
            "headers": {
              "Cache-Control": {
                "description": "Sensitive credential response must not be cached",
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferralPublicErrorResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Get privacy-safe runtime feature availability",
        "tags": [
          "app-config"
        ]
      }
    },
    "/v1/auth/legal/acceptances": {
      "post": {
        "operationId": "LegalAcceptanceController_accept",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 8,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegalAcceptanceDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCredentialsDto"
                }
              }
            },
            "description": "Legal compliance restored and session created",
            "headers": {
              "Cache-Control": {
                "description": "Sensitive credential response must not be cached",
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponseDto"
                }
              }
            },
            "description": "Stable product error without dependency details"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponseDto"
                }
              }
            },
            "description": "Stable product error without dependency details"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponseDto"
                }
              }
            },
            "description": "Stable product error without dependency details"
          }
        },
        "security": [
          {
            "RegistrationAuth": []
          }
        ],
        "summary": "Accept new legal versions and start a session",
        "tags": [
          "auth",
          "legal"
        ]
      }
    },
    "/v1/auth/otp/requests": {
      "post": {
        "operationId": "AuthController_request",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpIssuedResponseDto"
                }
              }
            },
            "description": "SMS accepted or delivery outcome uncertain"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponseDto"
                }
              }
            },
            "description": "Stable product error without dependency details"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponseDto"
                }
              }
            },
            "description": "Stable product error without dependency details"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponseDto"
                }
              }
            },
            "description": "Stable product error without dependency details"
          }
        },
        "summary": "Request the first OTP for a Senegal phone",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/otp/requests/{challengeId}/resend": {
      "post": {
        "operationId": "AuthController_resend",
        "parameters": [
          {
            "in": "path",
            "name": "challengeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpResendDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpIssuedResponseDto"
                }
              }
            },
            "description": "New challenge accepted; previous challenge is invalid"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
